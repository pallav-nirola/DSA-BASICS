bool string_matching(string &text, string &pattern)
{
    for (int i = 0; i <= text.length() - pattern.length(); i++)
    {
        int j;

        for (j = 0; j < pattern.length(); j++)
        {
            if (text[i + j] != pattern[j])
                break;
        }

        if (j == pattern.length())
            return true;
    }

    return false;
}


